---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${base}`, label: 'Home' },
  { href: `${base}docs/getting-started`, label: 'Docs' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0a0a0a]/95 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a href={base} class="text-lg font-bold tracking-widest text-white uppercase hover:text-emerald-500 transition-colors">
      PrismaUI F4
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class={`transition-colors hover:text-emerald-400 ${
              currentPath === href || (label === 'Docs' && currentPath.includes('/docs/'))
                ? 'text-emerald-400'
                : 'text-gray-300'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://github.com/PRISMA-USER-INTERFACE-FRAMEWORK/Prisma2.0"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-300 hover:text-white transition-colors"
        >
          GitHub
        </a>
      </li>
      <li>
        <a
          href="https://www.nexusmods.com/fallout4/mods/105454"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md bg-emerald-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-600 transition-colors"
        >
          Download
        </a>
      </li>
    </ul>
  </nav>
</header>
