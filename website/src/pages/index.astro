---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  {
    title: 'Chromium-based',
    body: 'Runs on CEF 147 inside Fallout 4. One shared browser, multiple views — each plugin gets an iframe with full isolation.',
  },
  {
    title: 'Modern HTML/CSS/JS',
    body: 'Write UIs with React, Vue, Tailwind, or plain HTML. No Scaleform. No Flash. No SWF authoring tools required.',
  },
  {
    title: 'C++ ↔ JS bridge',
    body: 'Call C++ from JavaScript with RegisterJSListener. Push data from C++ to JS with InteropCall. Clean, low-overhead messaging.',
  },
  {
    title: 'View roles',
    body: 'Tag views as panels, HUD widgets, or overlays. Any plugin can query IsAnyPanelVisible before opening its own UI — no more stacked menus.',
  },
  {
    title: 'View health monitoring',
    body: 'GetViewHealth tracks crash and load-failure counts. The framework warns and retries automatically — never a silent broken view.',
  },
  {
    title: 'F4SE plugin SDK',
    body: 'One header, runtime-resolved API — no link-time dependency on the framework DLL. Drop PrismaUI_F4_API.h in your src/ and go.',
  },
];
---

<Layout title="PrismaUI F4 — Chromium UI framework for Fallout 4">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 py-24 text-center">
    <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-emerald-500">
      F4SE Plugin Framework
    </p>
    <h1 class="mb-6 text-5xl font-extrabold leading-tight tracking-tight text-white">
      PrismaUI F4
    </h1>
    <p class="mx-auto mb-10 max-w-2xl text-lg text-gray-400">
      Build Fallout 4 menus, HUDs, and full-screen panels with HTML, CSS, and JavaScript.
      Powered by Chromium — no Scaleform, no Flash, no limits.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${base}docs/getting-started`}
        class="rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-emerald-500"
      >
        Get started
      </a>
      <a
        href={`${base}docs/api-reference`}
        class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-gray-300 transition-colors hover:border-white/40 hover:text-white"
      >
        API reference
      </a>
      <a
        href="https://www.nexusmods.com/fallout4/mods/105454"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-white/20 px-6 py-3 font-semibold text-gray-300 transition-colors hover:border-white/40 hover:text-white"
      >
        Download on Nexus
      </a>
    </div>
  </section>

  <!-- Feature grid -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(({ title, body }) => (
        <div class="rounded-xl border border-white/10 bg-white/5 p-6">
          <h3 class="mb-2 text-base font-semibold text-white">{title}</h3>
          <p class="text-sm leading-relaxed text-gray-400">{body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Quick install snippet -->
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="rounded-xl border border-white/10 bg-[#111] p-8">
      <h2 class="mb-4 text-xl font-bold text-white">Quick start</h2>
      <p class="mb-6 text-gray-400">
        Drop <code class="text-emerald-400">PrismaUI_F4_API.h</code> into your plugin's
        <code class="text-emerald-400">src/</code> directory. No link-time dependency — the API
        resolves at runtime via <code class="text-emerald-400">GetProcAddress</code>.
      </p>
      <pre class="overflow-x-auto rounded-lg bg-black/60 p-4 text-sm text-gray-300"><code
>#include "PrismaUI_F4_API.h"

// kGameDataReady
auto* api = PRISMA_UI_API::RequestPluginAPI&lt;PRISMA_UI_API::IVPrismaUI10&gt;();
if (!api) &#123; logger::error("PrismaUI V10 not found"); return; &#125;

// kPostLoadGame
auto view = api-&gt;CreateView("Interface/MyMod/ui.html", [](PrismaView v) &#123;
    api-&gt;RegisterJSListener(v, "onClose", [](const char*) &#123; api-&gt;Hide(view); &#125;);
    api-&gt;Invoke(v, "init()");
&#125;);
api-&gt;SetViewRole(view, PRISMA_UI_API::ViewRole::kPanel);
api-&gt;Hide(view);</code></pre>
      <a
        href={`${base}docs/getting-started`}
        class="mt-6 inline-block text-sm font-semibold text-emerald-400 hover:text-emerald-300"
      >
        Read the full guide
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-white/10 py-8 text-center text-sm text-gray-500">
    <p>
      PrismaUI F4 is a community-made framework for Fallout 4 mod authors.
      Not affiliated with Bethesda Softworks.
    </p>
    <p class="mt-2">
      <a href="https://github.com/PRISMA-USER-INTERFACE-FRAMEWORK/Prisma2.0" class="hover:text-gray-300">GitHub</a>
      &nbsp;&middot;&nbsp;
      <a href="https://www.nexusmods.com/fallout4/mods/105454" class="hover:text-gray-300">Nexus Mods</a>
    </p>
  </footer>
</Layout>
