---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// converts a collection id to a URL slug, matching Astro's own normalization
// (lowercase, dots stripped from non-extension positions)
// 'docs/getting-started.md' → 'getting-started'
// 'docs/api/CreateView.md'  → 'api/createview'
// 'docs/1.0-vs-2.0.md'     → '10-vs-20'
// 'CHANGELOG.md'            → 'changelog'
function idToSlug(id: string): string {
  if (id === 'CHANGELOG.md') return 'changelog';
  return id
    .replace(/^docs\//, '')
    .replace(/\.md$/, '')
    .toLowerCase()
    .replace(/\./g, '');
}

export async function getStaticPaths() {
  function idToSlug(id: string): string {
    if (id === 'CHANGELOG.md') return 'changelog';
    return id
      .replace(/^docs\//, '')
      .replace(/\.md$/, '')
      .toLowerCase()
      .replace(/\./g, '');
  }

  const entries = await getCollection('prismaui');
  return entries.map((entry) => ({
    params: { slug: idToSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const slug = idToSlug(entry.id);
const displayTitle =
  entry.data.title ??
  slug
    .split('/')
    .pop()!
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());

const base = import.meta.env.BASE_URL;
const currentSlug = slug;

const sidebarGroups = [
  {
    title: 'Getting Started',
    items: [
      { label: 'Introduction', slug: 'getting-started' },
      { label: 'Examples', slug: 'examples' },
      { label: 'Limitations', slug: 'limitations' },
    ],
  },
  {
    title: 'Guides',
    items: [
      { label: 'API Reference', slug: 'api-reference' },
      { label: 'HTML Views', slug: 'html-views' },
      { label: 'View Lifecycle', slug: 'view-lifecycle' },
      { label: 'Papyrus Bridge', slug: 'papyrus-bridge' },
      { label: 'Modern Frameworks', slug: 'modern-frameworks' },
      { label: 'Translations', slug: 'translations' },
      { label: 'MCM Integration', slug: 'prismamcm' },
    ],
  },
  {
    title: 'Reference',
    items: [
      { label: '1.0 vs 2.0', slug: '10-vs-20' },
      { label: 'Changelog', slug: 'changelog' },
    ],
  },
];
---

<Layout title={displayTitle} description={entry.data.description}>
  <div class="mx-auto flex max-w-6xl gap-8 px-6 py-10">
    <!-- Sidebar -->
    <aside class="hidden w-56 shrink-0 lg:block">
      <nav class="sticky top-20">
        {sidebarGroups.map(({ title, items }) => (
          <div class="mb-6">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">
              {title}
            </p>
            <ul class="space-y-1">
              {items.map(({ label, slug: itemSlug }) => (
                <li>
                  <a
                    href={`${base}docs/${itemSlug}`}
                    class={`block rounded px-2 py-1 text-sm transition-colors ${
                      currentSlug === itemSlug
                        ? 'bg-emerald-600/20 font-medium text-emerald-400'
                        : 'text-gray-400 hover:text-white'
                    }`}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Content -->
    <article class="min-w-0 flex-1">
      <div class="prose-doc">
        <Content />
      </div>
    </article>

    <!-- On-page TOC (headings) -->
    {headings.length > 1 && (
      <aside class="hidden w-44 shrink-0 xl:block">
        <nav class="sticky top-20">
          <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">
            On this page
          </p>
          <ul class="space-y-1">
            {headings.filter((h) => h.depth <= 3).map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class={`block text-sm text-gray-500 hover:text-gray-300 transition-colors ${h.depth === 3 ? 'pl-3' : ''}`}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Layout>
